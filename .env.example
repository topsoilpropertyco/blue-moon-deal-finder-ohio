# Copy this file to .env and fill in the values. Never commit .env.
# Easiest: uv run run.py key google (paste the key hidden) instead of editing this file.

# Google Maps Platform key (Geocoding, Routes, Street View Static, Maps Static).
GOOGLE_MAPS_API_KEY=

# Optional. Only needed if you switch the photo check from your Claude plan
# (vision.backend: claude_cli) to the pay-per-use API (vision.backend: anthropic_api).
ANTHROPIC_API_KEY=

# Optional. Free HUD USER API token (https://www.huduser.gov/hudapi/public/register).
# Not required: the app reads HUD rents from HUD's free public map service.
HUD_API_TOKEN=

# Optional. Free Census API key (https://api.census.gov/data/key_signup.html).
# Not used yet (planned: Census rent-by-bedroom as a second rent check). Safe to leave blank.
CENSUS_API_KEY=

# The team password for the team link (uv run run.py share). Make one with: uv run run.py share password
# Each person on the list (uv run run.py share add name@example.com) signs in with their email and this password.
APP_PASSWORD=
