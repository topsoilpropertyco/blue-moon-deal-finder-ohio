# Copy to config.local.yaml to keep YOUR settings here. Anything in it wins over config.yaml, and updates
# from GitHub never touch it (so `git pull` never complains about config.yaml).
# Only put the settings you change; for example, your permanent ngrok address:
#
# share:
#   provider: ngrok
#   ngrok_domain: something.ngrok-free.dev

# The Run screen's photo button stops at these per-run limits; press it again to carry on. To let one press
# do more (Google's free monthly allowance is about 10,000 of each kind of photo):
#
# google:
#   max_street_view_images_per_run: 9000
#   max_satellite_images_per_run: 3000
# vision:
#   max_calls_per_run: 3000
