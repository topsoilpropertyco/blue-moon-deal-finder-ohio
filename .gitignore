# Secrets
.env
# Your own settings on this computer (they win over config.yaml, so updates never clash with them)
config.local.yaml
.env.*
!.env.example

# Private data: owner names, addresses, photos, results. Never commit.
data/*
!data/crexi/
data/crexi/*
!data/crexi/.gitkeep
images/*
!images/.gitkeep
labels/*
!labels/.gitkeep
output/*
!output/.gitkeep
# The nightly update's log and last result (logs/auto_update.log, auto_update_state.json).
logs/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.xlsx
*.xlsm
*.xlsb
*.xls
*.csv
*.tsv
*.ods
*.numbers
# Downloaded exports (excluded.zip holds owner rows).
*.zip
!tests/fixtures/crexi_sample.csv
# Screenshots of the dashboard show owner names and addresses.
*.png
*.jpg
*.jpeg
*.webp
*.heic
*.pdf
# The Blue Moon logo files are not private data: keep them in git.
!docs/brand/*
!bluemoon/web/static/brand/*

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
*.log
